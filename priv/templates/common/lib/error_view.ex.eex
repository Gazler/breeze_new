defmodule <%= @module_name %>.ErrorView do
  use Breeze.View
  import Breeze.Blocks

  @impl true
  def render(assigns) do
    ~H"""
    <box class="grid grid-cols-1 grid-rows-2 w-screen h-screen bg">
      <box class="p-2">
        <.panel class="w-full h-full">
          <:title>Application error</:title>
          <box class="text-error font-bold">Something went wrong.</box>
          <box class="text-muted pt-1">Restart the application and try again.</box>
        </.panel>
      </box>
      <box class="h-1 w-full overflow-hidden bg-panel">
        <.keybinding_bar
          keybindings={@breeze.keybindings}
          class="inline w-full h-1 overflow-hidden bg-panel pl-1 pr-1"
        />
      </box>
    </box>
    """
  end
end
