defmodule <%= @module_name %>.ErrorView do
  use Breeze.View
  import Breeze.Blocks

  @impl true
  def render(assigns) do
    ~H"""
    <box class="grid grid-cols-1 grid-rows-2 width-screen height-screen bg">
      <box class="padding-2">
        <.panel class="width-full height-full">
          <:title>Application error</:title>
          <box class="text-error bold">Something went wrong.</box>
          <box class="text-muted padding-top-1">Restart the application and try again.</box>
        </.panel>
      </box>
      <box class="height-1 width-full overflow-hidden bg-panel">
        <.keybinding_bar
          keybindings={@breeze.keybindings}
          class="inline width-full height-1 overflow-hidden bg-panel padding-left-1 padding-right-1"
        />
      </box>
    </box>
    """
  end
end
