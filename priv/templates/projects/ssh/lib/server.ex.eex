defmodule <%= @module_name %>.Server do
  @moduledoc "Shared Breeze server configuration for SSH and local sessions."

  def start_link(overrides \\ []) do
    overrides
    |> options()
    |> Breeze.Server.start_link()
  end

  def run(overrides \\ []) do
    overrides
    |> options()
    |> Breeze.Server.run()
  end

  defp options(overrides) do
    Keyword.merge(
      [
        view: <%= @module_name %>.View,
        theme: <%= @theme %>,
        mouse: <%= inspect(@mouse) %>,
        inspector: Application.get_env(:<%= @app_name %>, :inspector, false),
        logger: Application.get_env(:<%= @app_name %>, :logger, false),
        reload: Application.get_env(:<%= @app_name %>, :reload, false),
        render_errors: Application.get_env(:<%= @app_name %>, :render_errors, []),
        global_keybindings: [
          <%= @ssh_theme_keybinding %>{"q", "Quit", fn _event, term -> {:stop, term} end}
        ]
      ],
      overrides
    )
  end
end
