defmodule <%= @module_name %>.View do
  use Breeze.View
  import Breeze.Blocks<%= if @storybook, do: "\n  import #{@module_name}.Components" %>

  @impl true
  def mount(_opts, term) do
    {:ok,
     term
     |> assign(counter: 0)
     |> put_local_keybindings([
       {"ArrowUp", "Increment"},
       {"ArrowDown", "Decrement"}
     ])}
  end

  @impl true
  def render(assigns) do
    ~H"""
    <box class="grid grid-cols-1 grid-rows-2 w-screen h-screen bg">
      <box class="p-2">
        <.panel class="w-full h-full">
          <:title><%= @module_name %></:title><%= if @storybook, do: "\n          <.metric label=\"Counter\" value={@counter}/>", else: "\n          <box class=\"text-primary font-bold\">Counter: {@counter}</box>" %>
          <box class="text-muted pt-1">Use the arrow keys to change the value.</box>
        </.panel>
      </box>
      <box class="h-1 w-full overflow-hidden bg-panel">
        <.keybinding_bar
          keybindings={@breeze.keybindings}
          class="inline w-full h-1 overflow-hidden bg-panel pl-1 pr-1"
        />
      </box>
    </box>
    """
  end

  @impl true
  def handle_event(_, %{"key" => "ArrowUp"}, term),
    do: {:noreply, assign(term, counter: term.assigns.counter + 1)}

  def handle_event(_, %{"key" => "ArrowDown"}, term),
    do: {:noreply, assign(term, counter: term.assigns.counter - 1)}

  def handle_event(_, _, term), do: {:noreply, term}
end
