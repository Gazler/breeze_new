defmodule <%= @module_name %>.ViewTest do
  use ExUnit.Case, async: true

  test "increments the counter" do
    session = Breeze.Test.start!(<%= @module_name %>.View, size: {50, 10})
    on_exit(fn -> Breeze.Test.stop(session) end)

    assert Breeze.Test.render_text!(session) =~ "Counter: 0"
    Breeze.Test.input(session, "ArrowUp")
    assert Breeze.Test.render_text!(session) =~ "Counter: 1"
  end
end
