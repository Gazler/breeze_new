defmodule <%= @module_name %>.View do
  use Breeze.View
  import Breeze.Blocks
  import <%= @module_name %>.KitchenSink<%= if @storybook, do: "\n  import #{@module_name}.Components" %>

  alias <%= @module_name %>.KitchenSink

  @action_ids ~w(demo-primary demo-reset show-flash clear-flash open-modal modal-close)

  @impl true
  def mount(_opts, term) do
    {:ok,
     term
     |> focus("gallery-tabs")
     |> clear_flash()
     |> put_local_keybindings([
       {"Tab", "Next"},
       {"ShiftTab", "Previous"},
       {"Enter", "Activate"}
     ])
     |> assign(
       section: "controls",
       checked: true,
       method: "GET",
       name: "Breeze developer",
       notes: "Every component is interactive.",
       action_count: 0,
       selected_item: "alpha",
       selected_node: "view",
       expanded_nodes: ["lib"],
       selected_city: "london",
       show_modal: false
     )}
  end

  @impl true
  def render(assigns) do
    ~H"""
    <box class="grid grid-cols-1 grid-rows-2 width-screen height-screen bg">
      <box class="padding-1 width-full height-full">
        <.panel id="kitchen-sink" class="width-full height-full">
          <:title><%= @module_name %> Kitchen Sink</:title>
          <box class="grid grid-cols-1 grid-rows-2 width-full height-full bg-panel">
            <box class="height-1 width-full overflow-hidden"><%= if @storybook do %>
              <.metric label="Built-in components" value={length(KitchenSink.component_names())}/><% else %>
              <box class="text-primary bold">Built-in components: {length(KitchenSink.component_names())}</box><% end %>
            </box>
            <.gallery
              section={@section}
              checked={@checked}
              method={@method}
              name={@name}
              notes={@notes}
              action_count={@action_count}
              selected_item={@selected_item}
              selected_node={@selected_node}
              expanded_nodes={@expanded_nodes}
              selected_city={@selected_city}
              terminal_width={@breeze.terminal.width}
            />
          </box>
        </.panel>
      </box>

      <box class="height-1 width-full overflow-hidden bg-panel">
        <.keybinding_bar
          keybindings={@breeze.keybindings}
          class="inline width-full height-1 overflow-hidden bg-panel padding-left-1 padding-right-1"
        />
      </box>

      <.flash_group
        flash={@breeze.flash}
        variant="rounded"
        width={overlay_width(@breeze.terminal.width)}
      />

      <.modal
        :if={@show_modal}
        id="demo-modal"
        width={modal_width(@breeze.terminal.width)}
        height={modal_height(@breeze.terminal.height)}
        dim
        br-change="modal_closed"
      >
        <:title>Kitchen Sink modal</:title>
        <box class="padding-2 width-full height-full">
          <box class="bold">This is a real Breeze modal.</box>
          <box class="text-muted width-full">Focus is trapped until the modal closes.</box>
          <box class="height-1"></box>
          <.button id="modal-close" default-focus class="width-14">Close</.button>
        </box>
      </.modal>
    </box>
    """
  end

  @impl true
  def handle_event("section_changed", %{value: value}, term) do
    if KitchenSink.section?(value) do
      {:noreply, assign(term, section: value)}
    else
      {:noreply, term}
    end
  end

  def handle_event("checked_changed", %{value: value}, term),
    do: {:noreply, assign(term, checked: value)}

  def handle_event("method_changed", %{value: value}, term),
    do: {:noreply, assign(term, method: value)}

  def handle_event("name_changed", %{value: value}, term),
    do: {:noreply, assign(term, name: value)}

  def handle_event("notes_changed", %{value: value}, term),
    do: {:noreply, assign(term, notes: value)}

  def handle_event("item_selected", %{value: value}, term),
    do: {:noreply, assign(term, selected_item: value)}

  def handle_event("node_selected", %{value: value, expanded: expanded}, term),
    do: {:noreply, assign(term, selected_node: value, expanded_nodes: expanded)}

  def handle_event("city_selected", %{value: value}, term),
    do: {:noreply, assign(term, selected_city: value)}

  def handle_event("modal_closed", _event, term),
    do: {:noreply, close_modal(term)}

  def handle_event(_, %{"key" => key}, %{focused: focused} = term)
      when key in ["Enter", " "] and focused in @action_ids do
    {:noreply, activate(focused, term)}
  end

  def handle_event(
        _,
        %{
          "mouse" => %{"button" => "left", "action" => "press"},
          "target" => target
        },
        term
      )
      when target in @action_ids do
    {:noreply, activate(target, term)}
  end

  def handle_event(_, _, term), do: {:noreply, term}

  defp activate("demo-primary", term) do
    term
    |> assign(action_count: term.assigns.action_count + 1)
    |> put_flash(:success, "Primary action ran",
      id: "button-action",
      title: "Button",
      duration: false
    )
  end

  defp activate("demo-reset", term) do
    term
    |> clear_flash()
    |> assign(action_count: 0)
  end

  defp activate("show-flash", term) do
    put_flash(term, :info, "Everything is working",
      id: "kitchen-sink-flash",
      title: "Flash message",
      duration: false
    )
  end

  defp activate("clear-flash", term), do: clear_flash(term)
  defp activate("open-modal", term), do: assign(term, show_modal: true)
  defp activate("modal-close", term), do: close_modal(term)
  defp activate(_id, term), do: term

  defp close_modal(term) do
    term
    |> assign(show_modal: false)
    |> focus("open-modal")
  end

  defp overlay_width(width), do: max(min(width - 2, 38), 20)
  defp modal_width(width), do: max(min(width - 4, 44), 20)
  defp modal_height(height), do: max(min(height - 4, 9), 7)
end
