defmodule <%= @module_name %>.View do
  use Breeze.View
  import Breeze.Blocks<%= if @storybook, do: "\n  import #{@module_name}.Components" %>

  @items [
    {"first", "Build the interface"},
    {"second", "Add application behaviour"},
    {"third", "Ship it"}
  ]

  @impl true
  def mount(_opts, term),
    do: {:ok, term |> focus("tasks") |> assign(selected: "first", items: @items)}

  @impl true
  def render(assigns) do
    ~H"""
    <box class="grid grid-cols-1 grid-rows-2 width-screen height-screen bg">
      <box class="padding-2">
        <.panel class="width-full height-full">
          <:title><%= @module_name %></:title><%= if @storybook, do: "\n          <.metric label=\"Tasks\" value={length(@items)}/>" %>
          <.list
            id="tasks"
            list-selected={@selected}
            br-change="selected"
            class="width-full height-full focus:border-primary"
          >
            <:item :for={{value, label} <- @items} value={value}>{label}</:item>
          </.list>
        </.panel>
      </box>
      <box class="height-1 width-full overflow-hidden bg-panel">
        <.keybinding_bar
          keybindings={@breeze.keybindings}
          class="inline width-full height-1 overflow-hidden bg-panel padding-left-1 padding-right-1"
        />
      </box>
    </box>
    """
  end

  @impl true
  def handle_event("selected", %{value: value}, term),
    do: {:noreply, assign(term, selected: value)}

  def handle_event(_, _, term), do: {:noreply, term}
end
